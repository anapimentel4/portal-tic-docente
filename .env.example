# Copia este archivo como .env y llena los valores. El .env NUNCA se sube a git.
# Solo lo usa el script del seed, que se ejecuta en tu computadora (fase 2).
# Están en Supabase → Project Settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Solo para ejecutar migraciones desde la terminal: Supabase → Connect → Session pooler,
# con la contraseña de la base de datos en lugar de [YOUR-PASSWORD]. Nunca se sube a git.
SUPABASE_DB_URL=
